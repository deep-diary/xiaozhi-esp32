# Merge / apply when building with -DDEEP_DOG_HANDLE_BT=ON
# (reference only; copy flags into sdkconfig as needed)

# Bluepad32 custom platform (required by handle_bt.cc)
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y

# ESP32-S3: BLE controller; Host = Controller only (BTstack is host)
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=y

# Mutually exclusive with BluFi / NimBLE provisioning on same firmware
CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n
