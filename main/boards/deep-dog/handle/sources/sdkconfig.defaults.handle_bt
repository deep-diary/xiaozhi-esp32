# Merge / apply when building with -DDEEP_DOG_HANDLE_BT=ON
# (reference only; copy flags into sdkconfig / sdkconfig.defaults.esp32s3 as needed)

# Bluepad32 custom platform (required by handle_bt.cc)
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_MAX_DEVICES=1
# 与小智 UART 监控互斥；开着会在 HCI 失败时 ESP_ERROR_CHECK abort 重启
# CONFIG_BLUEPAD32_USB_CONSOLE_ENABLE is not set

# ESP32-S3: BLE controller; Host = Controller only (BTstack is host)
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_CONTROLLER_ONLY=y

# 省内部 DRAM：单手柄 + 扫描即可，不必开外设广播
CONFIG_BT_CTRL_BLE_MAX_ACT=3
# CONFIG_BT_CTRL_BLE_ADV is not set
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50

# Mutually exclusive with BluFi / NimBLE provisioning on same firmware
CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n

# WiFi/LWIP 尽量上 PSRAM，给 HCI（INTERNAL|DMA）腾地方
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
